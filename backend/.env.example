# Copy to .env for local development. Never commit real values.

# "dev" turns on API debug output, any-origin CORS and file-based test emails.
APP_ENV=dev
VENDURE_SERVER_PORT=3000

# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# ── Postgres ─────────────────────────────────────────────────────────
# Local Postgres, a VPS, or Supabase (use the session pooler on port 5432 and DB_SSL=true).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moire_commerce
DB_USERNAME=moire
DB_PASSWORD=
DB_SCHEMA=public
DB_SSL=false

# ── Production only ──────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the APIs, e.g. https://www.moireco.com
CORS_ORIGINS=
# Public URL that asset (image) links start with, e.g. https://api.moireco.com/assets/
ASSET_URL_PREFIX=
# The storefront, used for links in customer emails.
STOREFRONT_URL=http://localhost:3001
# Payment gateways. Keys are entered on each payment method in the dashboard (Settings → Payment
# methods); these only pre-fill the methods when a shop is set up. CHIP: Brand ID and secret key from
# the CHIP merchant portal. Billplz: API key, collection ID and X Signature key; BILLPLZ_SANDBOX=true
# for billplz-sandbox.com.
CHIP_BRAND_ID=
CHIP_SECRET_KEY=
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_SANDBOX=true
# Couriers. Lalamove (same day): API key and secret from the Lalamove partner portal; LALAMOVE_SANDBOX=false
# for real bookings. EasyParcel (outstation): OAuth client from the EasyParcel Developer Hub, then connect
# the account once at <VENDURE_PUBLIC_URL>/delivery/easyparcel/connect while signed in to the dashboard.
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_SANDBOX=true
EASYPARCEL_CLIENT_ID=
EASYPARCEL_CLIENT_SECRET=
EASYPARCEL_SANDBOX=true
# Google Maps key with the Routes API (same-day prices by road distance from the shop) and the Geocoding
# API (Lalamove drop-off points). Without it, same-day delivery is charged at its fallback price.
GOOGLE_MAPS_API_KEY=
# Test payments (no money) work only in development. "true" allows them elsewhere, e.g. on a
# staging server; never on the live shop.
ALLOW_TEST_PAYMENTS=false
# How long an order's link opens without signing in, from when it was placed (e.g. 2h, 7d, 30d).
ORDER_LINK_VALID_FOR=30d
EMAIL_FROM="Moire Co." <hello@example.com>
# Where the shop is told about new enquiries (comma-separated for several addresses).
SHOP_NOTIFY_EMAIL=
# This backend's public address, e.g. https://api.moireco.com: payment gateway callbacks and
# "open in the dashboard" links in staff emails are built from it.
VENDURE_PUBLIC_URL=
# Customer emails: the shop's name, logo (an absolute https URL) and colours. Quote colours,
# because an unquoted # starts a comment.
SHOP_NAME="Moire Co."
EMAIL_LOGO_URL=https://www.example.com/brand/logo.png
EMAIL_BRAND_COLOR="#1f1c18"
EMAIL_ACCENT_COLOR="#8c6a32"
EMAIL_BACKGROUND_COLOR="#f4ebdc"
