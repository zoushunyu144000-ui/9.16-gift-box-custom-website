# Copy to .env for local development. Never commit real values.

# "dev" turns on API debug output, any-origin CORS and file-based test emails.
APP_ENV=dev
VENDURE_SERVER_PORT=3000

# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# ── Postgres ─────────────────────────────────────────────────────────
# Local Postgres, a VPS, or Supabase (use the session pooler on port 5432 and DB_SSL=true).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moire_commerce
DB_USERNAME=moire
DB_PASSWORD=
DB_SCHEMA=public
DB_SSL=false

# ── Production only ──────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the APIs, e.g. https://www.moireco.com
CORS_ORIGINS=
# Public URL that asset (image) links start with, e.g. https://api.moireco.com/assets/
ASSET_URL_PREFIX=
# The storefront, used for links in customer emails.
STOREFRONT_URL=http://localhost:3001
# How long an order's link opens without signing in, from when it was placed (e.g. 2h, 7d, 30d).
ORDER_LINK_VALID_FOR=30d
EMAIL_FROM="Moire Co." <hello@example.com>
# Customer emails: the shop's name, logo (an absolute https URL) and colours. Quote colours,
# because an unquoted # starts a comment.
SHOP_NAME="Moire Co."
EMAIL_LOGO_URL=https://www.example.com/brand/logo.png
EMAIL_BRAND_COLOR="#1f1c18"
EMAIL_ACCENT_COLOR="#8c6a32"
EMAIL_BACKGROUND_COLOR="#f4ebdc"
