{{> header title="Thank you for your order" }}

<mj-section background-color="#ffffff" padding="36px 32px 12px">
    <mj-column>
        <mj-text><span class="label">Order {{ order.code }}</span></mj-text>
        <mj-text><span class="heading">Thank you, {{ order.customer.firstName }}.</span></mj-text>
        <mj-text>
            Your payment was received and your order is confirmed. We’ll be in touch about delivery.
            Please keep your order number for reference.
        </mj-text>
        <mj-button href="{{ shopUrl }}/order/{{ order.code }}">View your order</mj-button>
    </mj-column>
</mj-section>

<mj-section background-color="#ffffff" padding="12px 32px">
    <mj-column>
        <mj-divider />
        <mj-text><span class="label">Delivery</span></mj-text>
        <mj-text>
            {{#with order.shippingAddress}}
            {{ fullName }}<br />
            {{ streetLine1 }}<br />
            {{#if streetLine2}}{{ streetLine2 }}<br />{{/if}}
            {{ postalCode }} {{ city }}{{#if province}}, {{ province }}{{/if}}
            {{#if phoneNumber}}<br /><span style="color: #6f675d;">{{ phoneNumber }}</span>{{/if}}
            {{/with}}
        </mj-text>
        {{#if order.customFields.preferredDeliveryDate}}
        <mj-text>Preferred date: {{ formatDate order.customFields.preferredDeliveryDate "dddd, d mmmm yyyy" }}</mj-text>
        {{/if}}
        {{#if order.customFields.deliveryNotes}}
        <mj-text color="#6f675d">Notes: {{ order.customFields.deliveryNotes }}</mj-text>
        {{/if}}
    </mj-column>
</mj-section>

<mj-section background-color="#ffffff" padding="12px 32px 32px">
    <mj-column>
        <mj-divider />
        <mj-text><span class="label">Your order</span></mj-text>
        <mj-table cellpadding="0" padding="0" font-size="14px" line-height="1.5" color="#2b2722">
            {{#each order.lines}}
            <tr>
                <td style="width: 56px; padding: 10px 12px 10px 0; border-bottom: 1px solid #ebe5dc; vertical-align: top;">
                    {{#if featuredAsset}}<img src="{{ featuredAsset.preview }}?w=96&h=120&mode=crop" width="48" height="60" alt="" style="display: block; border: 0;" />{{/if}}
                </td>
                <td style="padding: 10px 12px 10px 0; border-bottom: 1px solid #ebe5dc; vertical-align: top;">
                    {{ productVariant.name }} × {{ quantity }}
                    {{#if customFields.names}}<div style="color: #6f675d; font-size: 13px; white-space: pre-line;">{{ customFields.names }}</div>{{/if}}
                    {{#if customFields.giftMessage}}<div style="color: #6f675d; font-size: 13px; font-style: italic;">Gift message: “{{ customFields.giftMessage }}”</div>{{/if}}
                </td>
                <td style="padding: 10px 0; border-bottom: 1px solid #ebe5dc; text-align: right; vertical-align: top; white-space: nowrap;">
                    {{ formatMoney linePriceWithTax ../order.currencyCode 'en-MY' }}
                </td>
            </tr>
            {{/each}}
            {{!-- Items and delivery at full price, then each discount (codes, promotions, points). --}}
            {{#unless order.discounts.length}}
            <tr>
                <td></td>
                <td style="padding: 12px 12px 0 0; color: #6f675d;">Subtotal</td>
                <td style="padding: 12px 0 0; text-align: right; white-space: nowrap;">{{ formatMoney order.subTotalWithTax order.currencyCode 'en-MY' }}</td>
            </tr>
            {{/unless}}
            {{#each shippingLines}}
            <tr>
                <td></td>
                <td style="padding: 6px 12px 0 0; color: #6f675d;">{{ shippingMethod.name }}</td>
                <td style="padding: 6px 0 0; text-align: right; white-space: nowrap;">{{ formatMoney priceWithTax ../order.currencyCode 'en-MY' }}</td>
            </tr>
            {{/each}}
            {{#each order.discounts}}
            <tr>
                <td></td>
                <td style="padding: 6px 12px 0 0; color: #3f5e3a;">{{ description }}</td>
                <td style="padding: 6px 0 0; text-align: right; white-space: nowrap; color: #3f5e3a;">{{ formatMoney amountWithTax ../order.currencyCode 'en-MY' }}</td>
            </tr>
            {{/each}}
            <tr>
                <td></td>
                <td style="padding: 12px 12px 0 0; font-weight: bold;">Total paid</td>
                <td style="padding: 12px 0 0; text-align: right; font-weight: bold; white-space: nowrap;">{{ formatMoney order.totalWithTax order.currencyCode 'en-MY' }}</td>
            </tr>
        </mj-table>
    </mj-column>
</mj-section>

{{> footer }}
