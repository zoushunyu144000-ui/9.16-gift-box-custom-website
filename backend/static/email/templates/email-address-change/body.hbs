{{> header title="Confirm your new email address" }}

<mj-section background-color="#ffffff" padding="36px 32px">
    <mj-column>
        <mj-text><span class="heading">Confirm your new email address</span></mj-text>
        <mj-text>Please confirm this is the new email address for your {{ shopName }} account.</mj-text>
        <mj-button href="{{ changeEmailAddressUrl }}?token={{ identifierChangeToken }}">Confirm new email</mj-button>
        <mj-text font-size="13px" color="#6f675d">If you didn’t ask for this, you can ignore this email; your account keeps its current address.</mj-text>
    </mj-column>
</mj-section>

{{> footer }}
