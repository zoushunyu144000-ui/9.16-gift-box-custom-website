{{> header title="Reset your password" }}

<mj-section background-color="#ffffff" padding="36px 32px">
    <mj-column>
        <mj-text><span class="heading">Reset your password</span></mj-text>
        <mj-text>We received a request to reset the password for your {{ shopName }} account. Choose a new one with the button below.</mj-text>
        <mj-button href="{{ passwordResetUrl }}?token={{ passwordResetToken }}">Choose a new password</mj-button>
        <mj-text font-size="13px" color="#6f675d">If you didn’t ask for this, you can ignore this email; your password stays the same.</mj-text>
    </mj-column>
</mj-section>

{{> footer }}
