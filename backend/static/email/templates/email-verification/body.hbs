{{> header title="Confirm your email address" }}

<mj-section background-color="#ffffff" padding="36px 32px">
    <mj-column>
        <mj-text><span class="heading">Confirm your email address</span></mj-text>
        <mj-text>Thanks for creating your {{ shopName }} account. Please confirm this is your email address to finish setting it up.</mj-text>
        <mj-button href="{{ verifyEmailAddressUrl }}?token={{ verificationToken }}">Confirm my email</mj-button>
        <mj-text font-size="13px" color="#6f675d">If you didn’t create an account, you can ignore this email.</mj-text>
    </mj-column>
</mj-section>

{{> footer }}
