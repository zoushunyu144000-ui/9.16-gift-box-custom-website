{{!-- Shipped and delivered emails (couriers-my plugin). Variables: order, items, shipment, delivered. --}}
{{#if delivered}}
{{> header title="Your order has been delivered" }}
{{else}}
{{> header title="Your order is on its way" }}
{{/if}}

<mj-raw>
    <style type="text/css">
    .bg-off-white {
        background-color: #f5f5f5;
    }
    ul.address {
        list-style-type: none;
        padding: 0;
    }
    tr.item-row td {
        border-bottom: 1px dashed #eee;
        padding: 6px 0;
    }
    </style>
</mj-raw>

<mj-section css-class="bg-off-white">
    <mj-column>
        <mj-text>
            Dear {{ order.customer.firstName }} {{ order.customer.lastName }},
        </mj-text>
        {{#if delivered}}
        <mj-text>
            Your order <strong>{{ order.code }}</strong> has been delivered. We hope it brings a smile.
        </mj-text>
        {{else}}
        <mj-text>
            Good news: your order <strong>{{ order.code }}</strong> is on its way{{#if shipment.method}} ({{ shipment.method }}){{/if}}.
        </mj-text>
        {{/if}}
    </mj-column>
</mj-section>

{{#if shipment.trackingUrl}}
<mj-section>
    <mj-column>
        <mj-button href="{{ shipment.trackingUrl }}" background-color="#375a67" color="#ffffff">
            {{#if delivered}}View delivery details{{else}}Track your delivery{{/if}}
        </mj-button>
        {{#if shipment.trackingCode}}
        <mj-text align="center">Tracking number: {{ shipment.trackingCode }}</mj-text>
        {{/if}}
    </mj-column>
</mj-section>
{{else}}
{{#if shipment.trackingCode}}
<mj-section>
    <mj-column>
        <mj-text align="center">Tracking number: {{ shipment.trackingCode }}</mj-text>
    </mj-column>
</mj-section>
{{/if}}
{{/if}}

<mj-section>
    <mj-column>
        <mj-text>
            <h3>In this delivery</h3>
        </mj-text>
        <mj-table>
            {{#each items }}
            <tr class="item-row">
                <td>{{ quantity }} × {{ name }}</td>
            </tr>
            {{/each}}
        </mj-table>
    </mj-column>
</mj-section>

{{#with order.shippingAddress }}
<mj-section css-class="bg-off-white">
    <mj-column>
        <mj-text>
            <h3>Delivering to {{ fullName }}</h3>
            <ul class="address">
                {{#if company}}<li>{{ company }}</li>{{/if}}
                {{#if streetLine1}}<li>{{ streetLine1 }}</li>{{/if}}
                {{#if streetLine2}}<li>{{ streetLine2 }}</li>{{/if}}
                <li>{{ postalCode }} {{ city }}</li>
                {{#if province}}<li>{{ province }}</li>{{/if}}
            </ul>
        </mj-text>
    </mj-column>
</mj-section>
{{/with}}

{{> footer }}
