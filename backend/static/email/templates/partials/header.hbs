<mjml>
    <mj-head>
        <mj-title>{{ title }}</mj-title>
        <mj-preview>{{ title }}</mj-preview>
        <mj-attributes>
            <mj-all font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" />
            <mj-text font-size="15px" line-height="1.6" color="#2b2722" padding="6px 0" />
            <mj-button background-color="{{ brandColor }}" color="#ffffff" font-size="13px" letter-spacing="1px" border-radius="0" inner-padding="14px 28px" padding="18px 0 8px" align="left" />
            <mj-divider border-width="1px" border-color="#ebe5dc" padding="0 0 14px" />
        </mj-attributes>
        <mj-style inline="inline">
            .heading { font-family: Georgia, 'Times New Roman', serif; font-size: 26px; line-height: 1.25; color: #1f1c18; }
            .label { font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: #6f675d; }
            a { color: {{ accentColor }}; }
        </mj-style>
    </mj-head>

    <mj-body background-color="{{ backgroundColor }}" width="600px">
        <mj-section padding="32px 24px 20px">
            <mj-column>
                {{#if logoUrl}}
                <mj-image src="{{ logoUrl }}" alt="{{ shopName }}" width="150px" href="{{ shopUrl }}" padding="0" />
                {{else}}
                <mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-size="24px" letter-spacing="1px">
                    <a href="{{ shopUrl }}" style="color: #1f1c18; text-decoration: none;">{{ shopName }}</a>
                </mj-text>
                {{/if}}
            </mj-column>
        </mj-section>
