# ── Required before launch ───────────────────────────────────────────
# Long random string used to sign order links and the admin session.
APP_SECRET=
# Password for /admin (preview default: moire-preview)
ADMIN_PASSWORD=
# Public site address, e.g. https://www.moireco.com
NEXT_PUBLIC_SITE_URL=

# ── Commerce backend (Vendure; repository zoushunyu144000-ui/zoushunyu144000-ui-commerce-backend) ──
# When set, products, orders, payments, delivery, accounts and enquiries all run
# on the backend, staff use its dashboard, and the Supabase settings below are unused.
# The backend's Shop API, e.g. https://api.moireco.com/shop-api
VENDURE_SHOP_API_URL=
# Only for a backend with more than one shop (channel): this shop's channel token.
VENDURE_CHANNEL_TOKEN=
# Where /admin sends staff. Default: the dashboard beside the Shop API.
VENDURE_DASHBOARD_URL=

# ── Supabase (database + image storage) ─────────────────────────────
# Without these (and without the commerce backend) the site runs in demo mode with the sample catalogue.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ── Payments ────────────────────────────────────────────────────────
# Without the commerce backend: "test" = built-in simulated gateway (preview).
# With it, the gateways (CHIP, Billplz) are set up in the backend's dashboard instead.
PAYMENT_PROVIDER=test
