# ── Required before launch ───────────────────────────────────────────
# Long random string used to sign order links and the admin session.
APP_SECRET=
# Password for /admin (preview default: moire-preview)
ADMIN_PASSWORD=
# Public site address, e.g. https://www.moireco.com
NEXT_PUBLIC_SITE_URL=

# ── Supabase (database + image storage) ─────────────────────────────
# Without these the site runs in demo mode with the sample catalogue.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ── Payments ────────────────────────────────────────────────────────
# "test" = built-in simulated gateway (preview). Replace once a provider is chosen.
PAYMENT_PROVIDER=test
